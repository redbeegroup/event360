// Event 360 — Prisma schema v1 (Phase 0/1 core + placeholders for later phases)
// Conventions: UUID PKs, money in MMK as BigInt, snake_case table names.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_DATABASE_URL")
}

// ───────────────────────────── Identity & tenancy ─────────────────────────────

enum PlatformRole {
  CONSUMER
  PLATFORM_ADMIN
  PLATFORM_FINANCE
  SUPPORT
}

enum OrgRole {
  ORG_OWNER
  ORG_MANAGER
  ORG_FINANCE
  CREW
}

enum Locale {
  en
  my
}

model User {
  id            String         @id @default(uuid()) @db.Uuid
  displayName   String?        @map("display_name")
  phone         String?        @unique
  email         String?        @unique
  locale        Locale         @default(my)
  passwordHash  String?        @map("password_hash") // portal staff (admins/organizers); consumers use phone OTP
  platformRoles PlatformRole[] @default([CONSUMER]) @map("platform_roles")
  isActive      Boolean        @default(true) @map("is_active")
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")

  identities      UserIdentity[]
  seatMapVersions SeatMapVersion[]     @relation("SeatMapVersionCreator")
  devices         Device[]
  notifications   Notification[]
  memberships     OrganizationMember[]
  refreshTokens   RefreshToken[]
  invitations     Invitation[]         @relation("InvitedBy")
  orders          Order[]
  tickets         Ticket[]             @relation("TicketHolder")
  checkins        Checkin[]            @relation("CheckinCrew")
  waitlistEntries WaitlistEntry[]

  @@map("users")
}

enum IdentityProvider {
  PHONE
  EMAIL
  GOOGLE
  FACEBOOK
}

model UserIdentity {
  id        String           @id @default(uuid()) @db.Uuid
  userId    String           @map("user_id") @db.Uuid
  provider  IdentityProvider
  subject   String
  createdAt DateTime         @default(now()) @map("created_at")
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, subject])
  @@map("user_identities")
}

model OtpChallenge {
  id         String    @id @default(uuid()) @db.Uuid
  phone      String
  codeHash   String    @map("code_hash")
  attempts   Int       @default(0)
  expiresAt  DateTime  @map("expires_at")
  consumedAt DateTime? @map("consumed_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  @@index([phone, createdAt])
  @@map("otp_challenges")
}

model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("refresh_tokens")
}

model Device {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  platform  String // ios | android | web
  pushToken String?  @map("push_token")
  appId     String   @map("app_id") // user_app | organizer_app | crew_app
  lastSeen  DateTime @default(now()) @map("last_seen")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([pushToken])
  @@index([userId])
  @@map("devices")
}

/// In-app inbox (every notification lands here; push/SMS are extra channels).
model Notification {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  kind      String // ticket_confirmed | event_reminder | event_changed | event_cancelled | live_now | order_refunded | announcement | test | org_*
  audience  String    @default("attendee") // attendee (user app) | organizer (organizer app)
  title     String
  titleMy   String?   @map("title_my")
  body      String
  bodyMy    String?   @map("body_my")
  link      String? // in-app route, e.g. /event/<id>, /tickets, /watch/live/<id>
  eventId   String?   @map("event_id") @db.Uuid
  readAt    DateTime? @map("read_at")
  createdAt DateTime  @default(now()) @map("created_at")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, audience, createdAt])
  @@map("notifications")
}

/// Organizer message to an event's ticket holders.
model Announcement {
  id          String   @id @default(uuid()) @db.Uuid
  eventId     String   @map("event_id") @db.Uuid
  createdById String   @map("created_by_id") @db.Uuid
  title       String
  titleMy     String?  @map("title_my")
  body        String
  bodyMy      String?  @map("body_my")
  recipients  Int      @default(0)
  createdAt   DateTime @default(now()) @map("created_at")
  event       Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId, createdAt])
  @@map("announcements")
}

enum KycStatus {
  NOT_SUBMITTED
  PENDING
  APPROVED
  REJECTED
}

model Organization {
  id            String    @id @default(uuid()) @db.Uuid
  name          String
  slug          String    @unique
  description   String?
  logoUrl       String?   @map("logo_url")
  kycStatus     KycStatus @default(NOT_SUBMITTED) @map("kyc_status")
  kycNote       String?   @map("kyc_note")
  verifiedAt    DateTime? @map("verified_at")
  contactEmail  String?   @map("contact_email")
  contactPhone  String?   @map("contact_phone")
  website       String?
  facebookUrl   String?   @map("facebook_url")
  descriptionMy String?   @map("description_my")
  showContact   Boolean   @default(true) @map("show_contact")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  members       OrganizationMember[]
  invitations   Invitation[]
  events        Event[]
  subscriptions Subscription[]

  @@map("organizations")
}

model OrganizationMember {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  userId         String       @map("user_id") @db.Uuid
  role           OrgRole
  createdAt      DateTime     @default(now()) @map("created_at")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@map("organization_members")
}

/// One-time link for admins/organizer staff to set a password and join (no SMTP yet: the link is copied by hand).
model Invitation {
  id             String        @id @default(uuid()) @db.Uuid
  email          String
  tokenHash      String        @unique @map("token_hash")
  organizationId String?       @map("organization_id") @db.Uuid
  orgRole        OrgRole?      @map("org_role")
  platformRole   PlatformRole? @map("platform_role")
  invitedById    String?       @map("invited_by_id") @db.Uuid
  expiresAt      DateTime      @map("expires_at")
  acceptedAt     DateTime?     @map("accepted_at")
  createdAt      DateTime      @default(now()) @map("created_at")
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invitedBy      User?         @relation("InvitedBy", fields: [invitedById], references: [id])

  @@index([email])
  @@map("invitations")
}

// ───────────────────────────── Catalog & events ─────────────────────────────

model Category {
  id        String     @id @default(uuid()) @db.Uuid
  parentId  String?    @map("parent_id") @db.Uuid
  slug      String     @unique
  nameEn    String     @map("name_en")
  nameMy    String?    @map("name_my")
  iconKey   String?    @map("icon_key")
  sortOrder Int        @default(0) @map("sort_order")
  isActive  Boolean    @default(true) @map("is_active")
  parent    Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children  Category[] @relation("CategoryTree")
  events    Event[]

  @@map("categories")
}

model Venue {
  id           String  @id @default(uuid()) @db.Uuid
  name         String
  nameMy       String? @map("name_my")
  address      String?
  city         String
  latitude     Float?
  longitude    Float?
  mapUrl       String? @map("map_url")
  directions   String?
  directionsMy String? @map("directions_my")
  events       Event[]

  @@map("venues")
}

enum EventStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
  PUBLISHED
  ONGOING
  COMPLETED
  CANCELLED
}

enum EventFormat {
  IN_PERSON
  ONLINE
  HYBRID
}

enum EventVisibility {
  PUBLIC
  PRIVATE
}

model Event {
  id                  String          @id @default(uuid()) @db.Uuid
  organizationId      String          @map("organization_id") @db.Uuid
  categoryId          String          @map("category_id") @db.Uuid
  venueId             String?         @map("venue_id") @db.Uuid
  seatMapVersionId    String?         @map("seat_map_version_id") @db.Uuid
  title               String
  titleMy             String?         @map("title_my")
  slug                String          @unique
  summary             String?
  summaryMy           String?         @map("summary_my")
  description         String?
  descriptionMy       String?         @map("description_my")
  rejectionReason     String?         @map("rejection_reason")
  // Practical info (all optional, bilingual where free text)
  ageMin              Int?            @map("age_min")
  dressCode           String?         @map("dress_code")
  dressCodeMy         String?         @map("dress_code_my")
  languages           String?
  languagesMy         String?         @map("languages_my")
  parking             String?
  parkingMy           String?         @map("parking_my")
  accessibility       String?
  accessibilityMy     String?         @map("accessibility_my")
  whatToBring         String?         @map("what_to_bring")
  whatToBringMy       String?         @map("what_to_bring_my")
  terms               String?
  termsMy             String?         @map("terms_my")
  refundPolicy        String?         @map("refund_policy")
  refundPolicyMy      String?         @map("refund_policy_my")
  transfersEnabled    Boolean         @default(true) @map("transfers_enabled")
  transferCutoffHours Int             @default(2) @map("transfer_cutoff_hours") // no transfers this close to the start
  submittedAt         DateTime?       @map("submitted_at")
  coverImageUrl       String?         @map("cover_image_url")
  status              EventStatus     @default(DRAFT)
  format              EventFormat     @default(IN_PERSON)
  visibility          EventVisibility @default(PUBLIC)
  isFree              Boolean         @default(false) @map("is_free")
  startsAt            DateTime        @map("starts_at")
  endsAt              DateTime        @map("ends_at")
  publishedAt         DateTime?       @map("published_at")
  reminderSentAt      DateTime?       @map("reminder_sent_at") // day-before reminder sent
  salesMilestone      Int             @default(0) @map("sales_milestone") // organizer told: 1 = first paid order, 50 = half sold, 100 = sold out
  createdAt           DateTime        @default(now()) @map("created_at")
  updatedAt           DateTime        @updatedAt @map("updated_at")

  organization   Organization      @relation(fields: [organizationId], references: [id])
  category       Category          @relation(fields: [categoryId], references: [id])
  venue          Venue?            @relation(fields: [venueId], references: [id])
  sessions       EventSession[]
  performers     EventPerformer[]
  media          EventMedia[]
  faqs           EventFaq[]
  ticketTypes    TicketType[]
  orders         Order[]
  promoBookings  PromoBooking[]
  checkins       Checkin[]
  accessCodes    EventAccessCode[]
  liveChannels   LiveChannel[]
  announcements  Announcement[]
  promoCodes     PromoCode[]
  groupDiscounts GroupDiscount[]
  dailyStats     EventDailyStat[]
  vodAssets      VodAsset[]
  seatMapVersion SeatMapVersion?   @relation(fields: [seatMapVersionId], references: [id], onDelete: Restrict)
  eventSections  EventSection[]
  eventSeats     EventSeat[]

  @@index([status, startsAt])
  @@index([categoryId, startsAt])
  @@index([organizationId, status])
  @@map("events")
}

/// Schedule / agenda item.
model EventSession {
  id            String       @id @default(uuid()) @db.Uuid
  eventId       String       @map("event_id") @db.Uuid
  title         String
  titleMy       String?      @map("title_my")
  description   String?
  descriptionMy String?      @map("description_my")
  location      String? // e.g. "Main stage", "Hall B"
  startsAt      DateTime     @map("starts_at")
  endsAt        DateTime     @map("ends_at")
  event         Event        @relation(fields: [eventId], references: [id], onDelete: Cascade)
  liveChannel   LiveChannel?

  @@index([eventId, startsAt])
  @@map("event_sessions")
}

/// Lineup: performers, speakers, hosts.
model EventPerformer {
  id        String  @id @default(uuid()) @db.Uuid
  eventId   String  @map("event_id") @db.Uuid
  name      String
  nameMy    String? @map("name_my")
  role      String? // e.g. "Headliner", "Keynote speaker"
  roleMy    String? @map("role_my")
  bio       String?
  bioMy     String? @map("bio_my")
  photoKey  String? @map("photo_key")
  sortOrder Int     @default(0) @map("sort_order")
  event     Event   @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId, sortOrder])
  @@map("event_performers")
}

/// Gallery images (the cover stays on Event.coverImageUrl).
model EventMedia {
  id        String  @id @default(uuid()) @db.Uuid
  eventId   String  @map("event_id") @db.Uuid
  key       String
  caption   String?
  captionMy String? @map("caption_my")
  sortOrder Int     @default(0) @map("sort_order")
  event     Event   @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId, sortOrder])
  @@map("event_media")
}

model EventFaq {
  id         String  @id @default(uuid()) @db.Uuid
  eventId    String  @map("event_id") @db.Uuid
  question   String
  questionMy String? @map("question_my")
  answer     String
  answerMy   String? @map("answer_my")
  sortOrder  Int     @default(0) @map("sort_order")
  event      Event   @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId, sortOrder])
  @@map("event_faqs")
}

// ───────────────────────────── Ticketing & orders ─────────────────────────────

enum DeliveryMode {
  IN_PERSON
  LIVE_ONLINE
  RECORDING
  BUNDLE
}

model TicketType {
  id            String            @id @default(uuid()) @db.Uuid
  eventId       String            @map("event_id") @db.Uuid
  name          String
  nameMy        String?           @map("name_my")
  priceMmk      BigInt            @default(0) @map("price_mmk")
  quota         Int
  sold          Int               @default(0)
  held          Int               @default(0)
  /// Reserved for the waitlist: standing = quantity moved here for offers; seated = WAITLIST_HOLD seats (recountTicketTypes).
  offered       Int               @default(0)
  maxPerOrder   Int               @default(10) @map("max_per_order")
  deliveryMode  DeliveryMode      @default(IN_PERSON) @map("delivery_mode")
  salesStartAt  DateTime?         @map("sales_start_at")
  salesEndAt    DateTime?         @map("sales_end_at")
  color         String?
  event         Event             @relation(fields: [eventId], references: [id], onDelete: Cascade)
  orderItems    OrderItem[]
  tickets       Ticket[]
  eventSections EventSection[]
  eventSeats    EventSeat[]
  priceSteps    TicketPriceStep[]
  waitlist      WaitlistEntry[]

  @@map("ticket_types")
}

/// From `startsAt` the ticket type sells at `priceMmk` (the type's own price is the price before the first step).
model GroupDiscount {
  id          String @id @default(uuid()) @db.Uuid
  eventId     String @map("event_id") @db.Uuid
  minQuantity Int    @map("min_quantity")
  percentBp   Int    @map("percent_bp")
  event       Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([eventId, minQuantity])
  @@map("group_discounts")
}

model TicketPriceStep {
  id           String     @id @default(uuid()) @db.Uuid
  ticketTypeId String     @map("ticket_type_id") @db.Uuid
  startsAt     DateTime   @map("starts_at")
  priceMmk     BigInt     @map("price_mmk")
  ticketType   TicketType @relation(fields: [ticketTypeId], references: [id], onDelete: Cascade)

  @@unique([ticketTypeId, startsAt])
  @@map("ticket_price_steps")
}

enum OrderStatus {
  PENDING_PAYMENT
  PAID
  CONFIRMED // free orders
  EXPIRED
  FAILED
  REFUNDED
  CANCELLED
}

model Order {
  id              String      @id @default(uuid()) @db.Uuid
  userId          String      @map("user_id") @db.Uuid
  eventId         String      @map("event_id") @db.Uuid
  status          OrderStatus @default(PENDING_PAYMENT)
  subtotalMmk     BigInt      @map("subtotal_mmk")
  buyerFeeMmk     BigInt      @default(0) @map("buyer_fee_mmk")
  totalMmk        BigInt      @map("total_mmk")
  commissionMmk   BigInt      @default(0) @map("commission_mmk") // frozen at checkout
  idempotencyKey  String?     @unique @map("idempotency_key")
  holdExpiresAt   DateTime?   @map("hold_expires_at")
  channel         String      @default("APP") // APP | WEB | POS | COMP (guest tickets: zero total, outside revenue)
  paidAt          DateTime?   @map("paid_at")
  needsReview     Boolean     @default(false) @map("needs_review") // paid after the hold expired with no seats left → refund
  promoCodeId     String?     @map("promo_code_id") @db.Uuid
  discountMmk     BigInt      @default(0) @map("discount_mmk")
  groupDiscountBp Int?        @map("group_discount_bp") // set when the group discount was the one applied (promoCodeId is then null)
  reviewNote      String?     @map("review_note")
  createdAt       DateTime    @default(now()) @map("created_at")
  updatedAt       DateTime    @updatedAt @map("updated_at")

  user            User            @relation(fields: [userId], references: [id])
  event           Event           @relation(fields: [eventId], references: [id])
  items           OrderItem[]
  payments        Payment[]
  tickets         Ticket[]
  refunds         Refund[]
  waitlistEntries WaitlistEntry[]
  promoCode       PromoCode?      @relation(fields: [promoCodeId], references: [id])

  @@index([status, holdExpiresAt])
  @@index([eventId, status])
  @@map("orders")
}

model OrderItem {
  id           String     @id @default(uuid()) @db.Uuid
  orderId      String     @map("order_id") @db.Uuid
  ticketTypeId String     @map("ticket_type_id") @db.Uuid
  quantity     Int
  unitPriceMmk BigInt     @map("unit_price_mmk")
  /// Seated lines: the seats bought (one ticket each); kept after a hold expires so a late payment can re-claim them.
  seatKeys     String[]   @default([]) @map("seat_keys")
  order        Order      @relation(fields: [orderId], references: [id], onDelete: Cascade)
  ticketType   TicketType @relation(fields: [ticketTypeId], references: [id])

  @@map("order_items")
}

enum TicketStatus {
  VALID
  CHECKED_IN
  TRANSFERRED
  REFUNDED
  VOID
}

model Ticket {
  id              String           @id @default(uuid()) @db.Uuid
  orderId         String           @map("order_id") @db.Uuid
  ticketTypeId    String           @map("ticket_type_id") @db.Uuid
  holderUserId    String           @map("holder_user_id") @db.Uuid
  status          TicketStatus     @default(VALID)
  qrVersion       Int              @default(1) @map("qr_version")
  transferCount   Int              @default(0) @map("transfer_count")
  seatKey         String?          @map("seat_key")
  seatLabel       String?          @map("seat_label")
  seatLabelMy     String?          @map("seat_label_my")
  isComplimentary Boolean          @default(false) @map("is_complimentary")
  compLabel       String?          @map("comp_label")
  guestName       String?          @map("guest_name")
  createdAt       DateTime         @default(now()) @map("created_at")
  eventSeat       EventSeat?
  order           Order            @relation(fields: [orderId], references: [id])
  ticketType      TicketType       @relation(fields: [ticketTypeId], references: [id])
  holder          User             @relation("TicketHolder", fields: [holderUserId], references: [id])
  checkins        Checkin[]
  transfers       TicketTransfer[]

  @@map("tickets")
}

enum CheckinMethod {
  QR
  MANUAL
}

/// One scan or manual check-in. Repeat scans of an already checked-in ticket are kept with isDuplicate=true.
model Checkin {
  id            String        @id @default(uuid()) @db.Uuid
  ticketId      String        @map("ticket_id") @db.Uuid
  eventId       String        @map("event_id") @db.Uuid
  crewUserId    String?       @map("crew_user_id") @db.Uuid // invited crew / organizer staff
  crewSessionId String?       @map("crew_session_id") @db.Uuid // volunteer on an event code
  method        CheckinMethod @default(QR)
  gate          String?
  deviceId      String?       @map("device_id")
  scannedAt     DateTime      @map("scanned_at")
  offline       Boolean       @default(false)
  isDuplicate   Boolean       @default(false) @map("is_duplicate")
  undoneAt      DateTime?     @map("undone_at")
  undoneBy      String?       @map("undone_by") // "user:<id>" or "crew:<sessionId>"
  createdAt     DateTime      @default(now()) @map("created_at")
  ticket        Ticket        @relation(fields: [ticketId], references: [id])
  event         Event         @relation(fields: [eventId], references: [id], onDelete: Cascade)
  crewUser      User?         @relation("CheckinCrew", fields: [crewUserId], references: [id])
  crewSession   CrewSession?  @relation(fields: [crewSessionId], references: [id])

  @@index([ticketId, scannedAt])
  @@index([eventId, scannedAt])
  @@map("checkins")
}

/// Short code an organizer hands to door volunteers; redeeming it gives a device a check-in session for one event.
model EventAccessCode {
  id          String        @id @default(uuid()) @db.Uuid
  eventId     String        @map("event_id") @db.Uuid
  codeHash    String        @unique @map("code_hash")
  label       String
  gate        String?
  createdById String        @map("created_by_id") @db.Uuid
  expiresAt   DateTime      @map("expires_at")
  revokedAt   DateTime?     @map("revoked_at")
  createdAt   DateTime      @default(now()) @map("created_at")
  event       Event         @relation(fields: [eventId], references: [id], onDelete: Cascade)
  sessions    CrewSession[]

  @@index([eventId])
  @@map("event_access_codes")
}

model CrewSession {
  id           String          @id @default(uuid()) @db.Uuid
  accessCodeId String          @map("access_code_id") @db.Uuid
  eventId      String          @map("event_id") @db.Uuid
  deviceName   String          @map("device_name")
  createdAt    DateTime        @default(now()) @map("created_at")
  revokedAt    DateTime?       @map("revoked_at")
  accessCode   EventAccessCode @relation(fields: [accessCodeId], references: [id], onDelete: Cascade)
  checkins     Checkin[]

  @@index([eventId])
  @@map("crew_sessions")
}

// ───────────────────────────── Payments & ledger ─────────────────────────────

enum PaymentProviderCode {
  KBZPAY
  WAVEPAY
  CBPAY
  AYAPAY
  MPU
  CB_MPGS
  CASH
  MOCK
}

enum PaymentStatus {
  INITIATED
  PENDING
  SUCCEEDED
  FAILED
  EXPIRED
  REFUNDED
}

model Payment {
  id            String              @id @default(uuid()) @db.Uuid
  orderId       String?             @map("order_id") @db.Uuid
  purpose       String              @default("ORDER") // ORDER | SUBSCRIPTION | PROMOTION
  provider      PaymentProviderCode
  providerRef   String?             @map("provider_ref")
  amountMmk     BigInt              @map("amount_mmk")
  status        PaymentStatus       @default(INITIATED)
  /// What the client does next: { type: REDIRECT|DEEPLINK|QR, url?, deeplink?, qr? }
  action        Json?
  expiresAt     DateTime?           @map("expires_at")
  failureReason String?             @map("failure_reason")
  lastCheckedAt DateTime?           @map("last_checked_at")
  createdAt     DateTime            @default(now()) @map("created_at")
  updatedAt     DateTime            @updatedAt @map("updated_at")
  order         Order?              @relation(fields: [orderId], references: [id])
  events        PaymentEvent[]
  refunds       Refund[]

  @@unique([provider, providerRef])
  @@index([status, createdAt])
  @@map("payments")
}

enum RefundStatus {
  PENDING
  SUCCEEDED
  FAILED
  MANUAL // provider has no refund API: admin returns the money and records the reference
}

model Refund {
  id          String       @id @default(uuid()) @db.Uuid
  orderId     String       @map("order_id") @db.Uuid
  paymentId   String?      @map("payment_id") @db.Uuid
  amountMmk   BigInt       @map("amount_mmk")
  status      RefundStatus @default(PENDING)
  reason      String
  providerRef String?      @map("provider_ref")
  reference   String? // manual transfer reference entered by the admin
  error       String?
  createdById String       @map("created_by_id") @db.Uuid
  completedAt DateTime?    @map("completed_at")
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")
  order       Order        @relation(fields: [orderId], references: [id])
  payment     Payment?     @relation(fields: [paymentId], references: [id])

  @@index([status])
  @@map("refunds")
}

model PaymentEvent {
  id         String              @id @default(uuid()) @db.Uuid
  paymentId  String?             @map("payment_id") @db.Uuid
  provider   PaymentProviderCode
  rawPayload Json                @map("raw_payload")
  verified   Boolean
  receivedAt DateTime            @default(now()) @map("received_at")
  payment    Payment?            @relation(fields: [paymentId], references: [id])

  @@map("payment_events")
}

model LedgerEntry {
  id        String   @id @default(uuid()) @db.Uuid
  journalId String   @map("journal_id") @db.Uuid // groups balanced debit/credit lines
  account   String // e.g. provider_clearing:KBZPAY, platform_commission, organizer_payable:<orgId>
  debitMmk  BigInt   @default(0) @map("debit_mmk")
  creditMmk BigInt   @default(0) @map("credit_mmk")
  refType   String   @map("ref_type")
  refId     String   @map("ref_id")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([journalId])
  @@index([account])
  @@map("ledger_entries")
}

// ───────────────────────────── Billing ─────────────────────────────

enum FeeScope {
  GLOBAL
  CATEGORY
  ORGANIZATION
  EVENT
}

model FeeRule {
  id        String   @id @default(uuid()) @db.Uuid
  scope     FeeScope
  scopeId   String?  @map("scope_id") @db.Uuid
  percentBp Int      @map("percent_bp") // basis points: 500 = 5%
  fixedMmk  BigInt   @default(0) @map("fixed_mmk")
  minMmk    BigInt?  @map("min_mmk")
  maxMmk    BigInt?  @map("max_mmk")
  buyerPays Boolean  @default(false) @map("buyer_pays")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("fee_rules")
}

enum PlanScope {
  ORGANIZER
  EVENT
}

model Plan {
  id            String         @id @default(uuid()) @db.Uuid
  code          String         @unique
  name          String
  scope         PlanScope
  priceMmk      BigInt         @map("price_mmk")
  periodDays    Int?           @map("period_days") // null for one-off per-event plans
  limits        Json // { maxEvents, maxTickets, crewSeats, liveHours, maxViewers, storageGb, commissionBp }
  isActive      Boolean        @default(true) @map("is_active")
  subscriptions Subscription[]

  @@map("plans")
}

model Subscription {
  id             String       @id @default(uuid()) @db.Uuid
  planId         String       @map("plan_id") @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  eventId        String?      @map("event_id") @db.Uuid
  status         String       @default("PENDING") // PENDING | ACTIVE | EXPIRED | CANCELLED
  startsAt       DateTime?    @map("starts_at")
  endsAt         DateTime?    @map("ends_at")
  plan           Plan         @relation(fields: [planId], references: [id])
  organization   Organization @relation(fields: [organizationId], references: [id])

  @@map("subscriptions")
}

// ───────────────────────────── Streaming (Phase 5b) ─────────────────────────────

/// One live stream per event session. Organizers push RTMP/SRT to SRS at /live/<ingestKey>?key=<streamKey>.
model LiveChannel {
  id               String       @id @default(uuid()) @db.Uuid
  sessionId        String       @unique @map("session_id") @db.Uuid
  eventId          String       @map("event_id") @db.Uuid
  ingestKey        String       @unique @map("ingest_key") // public part of the RTMP path
  streamKeyHash    String       @map("stream_key_hash")
  status           String       @default("IDLE") // IDLE | LIVE | ENDED
  recordingEnabled Boolean      @default(true) @map("recording_enabled")
  jobName          String?      @map("job_name")
  srsClientId      String?      @map("srs_client_id") // to disconnect the encoder via the SRS API
  livePrefix       String?      @map("live_prefix") // S3 prefix of the current live HLS (the recording itself when recording)
  startedAt        DateTime?    @map("started_at")
  endedAt          DateTime?    @map("ended_at")
  peakViewers      Int          @default(0) @map("peak_viewers")
  liveNotifiedAt   DateTime?    @map("live_notified_at") // "live now" sent (once per session window)
  createdAt        DateTime     @default(now()) @map("created_at")
  session          EventSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  event            Event        @relation(fields: [eventId], references: [id], onDelete: Cascade)
  vodAssets        VodAsset[]

  @@index([eventId])
  @@map("live_channels")
}

/// A recording (from a live stream) or an uploaded video, stored as HLS in SeaweedFS under <prefix>/vod/<id>/.
model VodAsset {
  id             String       @id @default(uuid()) @db.Uuid
  eventId        String       @map("event_id") @db.Uuid
  sessionId      String?      @map("session_id") @db.Uuid
  liveChannelId  String?      @map("live_channel_id") @db.Uuid
  title          String
  titleMy        String?      @map("title_my")
  source         String       @default("LIVE") // LIVE | UPLOAD
  status         String       @default("PROCESSING") // PROCESSING | READY | FAILED
  error          String?
  s3Prefix       String       @map("s3_prefix")
  renditions     Json?
  durationSec    Int?         @map("duration_sec")
  sizeBytes      BigInt?      @map("size_bytes")
  jobName        String?      @map("job_name")
  published      Boolean      @default(false)
  availableFrom  DateTime?    @map("available_from")
  availableUntil DateTime?    @map("available_until")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")
  liveChannel    LiveChannel? @relation(fields: [liveChannelId], references: [id], onDelete: SetNull)
  event          Event        @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId])
  @@map("vod_assets")
}

/// A viewer's active playback (one device at a time per user and stream/recording).
model PlaybackSession {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  targetType String    @map("target_type") // LIVE | VOD
  targetId   String    @map("target_id") @db.Uuid
  createdAt  DateTime  @default(now()) @map("created_at")
  lastSeenAt DateTime  @default(now()) @map("last_seen_at")
  revokedAt  DateTime? @map("revoked_at")

  @@index([userId, targetId])
  @@index([targetId, lastSeenAt])
  @@map("playback_sessions")
}

// ───────────────────────────── Featured promotions (Phase 5a) ─────────────────────────────

model PromoPlacement {
  id             String         @id @default(uuid()) @db.Uuid
  code           String         @unique // HOME_HERO | HOME_FEATURED_ROW | CATEGORY_TOP | SEARCH_BOOST | CITY_TOP | PUSH_BLAST | ORGANIZER_SPOTLIGHT
  name           String
  slotsPerDay    Int            @map("slots_per_day")
  pricePerDayMmk BigInt         @map("price_per_day_mmk")
  isActive       Boolean        @default(true) @map("is_active")
  bookings       PromoBooking[]

  @@map("promo_placements")
}

model PromoBooking {
  id          String         @id @default(uuid()) @db.Uuid
  placementId String         @map("placement_id") @db.Uuid
  eventId     String         @map("event_id") @db.Uuid
  targetKey   String?        @map("target_key") // e.g. category slug or city
  startDate   DateTime       @map("start_date") @db.Date
  endDate     DateTime       @map("end_date") @db.Date
  priceMmk    BigInt         @map("price_mmk")
  status      String         @default("PENDING_PAYMENT") // PENDING_PAYMENT | PENDING_APPROVAL | APPROVED | LIVE | ENDED | REJECTED | REFUNDED
  creativeUrl String?        @map("creative_url")
  createdAt   DateTime       @default(now()) @map("created_at")
  placement   PromoPlacement @relation(fields: [placementId], references: [id])
  event       Event          @relation(fields: [eventId], references: [id])

  @@index([placementId, startDate, endDate])
  @@map("promo_bookings")
}

// ───────────────────────────── Audit ─────────────────────────────

model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  actorId    String?  @map("actor_id") @db.Uuid
  action     String
  entityType String   @map("entity_type")
  entityId   String?  @map("entity_id")
  data       Json?
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([entityType, entityId])
  @@map("audit_logs")
}

// ───────────────────────────── Platform settings & notifications ─────────────────────────────

/// Admin-editable platform configuration (e.g. "sms"). Secret fields inside `value` are AES-GCM encrypted with SETTINGS_KEY.
model PlatformSetting {
  key         String   @id
  value       Json
  updatedById String?  @map("updated_by_id") @db.Uuid
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("platform_settings")
}

/// One outgoing SMS. The message text is not stored (it may contain a login code).
model SmsLog {
  id                String   @id @default(uuid()) @db.Uuid
  provider          String
  to                String // masked, e.g. 959•••••1234
  purpose           String // otp | test
  status            String // accepted | failed
  providerMessageId String?  @map("provider_message_id")
  error             String?
  testMode          Boolean  @default(false) @map("test_mode")
  createdAt         DateTime @default(now()) @map("created_at")

  @@index([createdAt])
  @@map("sms_logs")
}

enum PromoKind {
  PERCENT // value = basis points (1000 = 10%)
  FIXED // value = MMK off the order
}

/// Organizer discount code for one event (applies to paid orders).
model PromoCode {
  id            String    @id @default(uuid()) @db.Uuid
  eventId       String    @map("event_id") @db.Uuid
  code          String // stored upper-case
  kind          PromoKind
  value         Int
  maxUses       Int?      @map("max_uses")
  used          Int       @default(0)
  startsAt      DateTime? @map("starts_at")
  endsAt        DateTime? @map("ends_at")
  ticketTypeIds String[]  @default([]) @map("ticket_type_ids") @db.Uuid // empty = all ticket types
  isActive      Boolean   @default(true) @map("is_active")
  createdById   String    @map("created_by_id") @db.Uuid
  createdAt     DateTime  @default(now()) @map("created_at")
  event         Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  orders        Order[]

  @@unique([eventId, code])
  @@map("promo_codes")
}

model TicketTransfer {
  id         String   @id @default(uuid()) @db.Uuid
  ticketId   String   @map("ticket_id") @db.Uuid
  fromUserId String   @map("from_user_id") @db.Uuid
  toUserId   String   @map("to_user_id") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at")
  ticket     Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId])
  @@map("ticket_transfers")
}

/// Per-day public event page views (Myanmar date), for the organizer dashboard.
model EventDailyStat {
  eventId String   @map("event_id") @db.Uuid
  day     DateTime @db.Date
  views   Int      @default(0)
  event   Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@id([eventId, day])
  @@map("event_daily_stats")
}

// ───────────────────────────── Operations ─────────────────────────────

/// Errors grouped by fingerprint (same message + place), from the API, web servers and the apps.
model ErrorGroup {
  id          String    @id @default(uuid()) @db.Uuid
  fingerprint String    @unique
  source      String // api | portal | site | user_app | crew_app | organizer_app
  message     String
  stack       String?
  path        String? // request path or app route
  count       Int       @default(1)
  firstSeen   DateTime  @default(now()) @map("first_seen")
  lastSeen    DateTime  @default(now()) @map("last_seen")
  lastRelease String?   @map("last_release")
  lastContext Json?     @map("last_context")
  resolvedAt  DateTime? @map("resolved_at")
  alertedAt   DateTime? @map("alerted_at")

  @@index([lastSeen])
  @@map("error_groups")
}

/// Latest state of each health check (one row per check).
model MonitorCheck {
  name                String    @id
  ok                  Boolean   @default(true)
  consecutiveFailures Int       @default(0) @map("consecutive_failures")
  lastError           String?   @map("last_error")
  detail              String?
  lastCheckedAt       DateTime? @map("last_checked_at")
  changedAt           DateTime  @default(now()) @map("changed_at")
  alerting            Boolean   @default(false) // an alert was sent and recovery not yet announced

  @@map("monitor_checks")
}

model MonitorIncident {
  id        String    @id @default(uuid()) @db.Uuid
  check     String
  error     String
  startedAt DateTime  @default(now()) @map("started_at")
  endedAt   DateTime? @map("ended_at")

  @@index([startedAt])
  @@map("monitor_incidents")
}

// ---------------------------------------------------------------------------
// Reserved seating
// ---------------------------------------------------------------------------

enum SeatStatus {
  AVAILABLE
  CHECKOUT_HOLD
  GUEST_HOLD
  SOLD
  UNSOLD // no ticket type assigned
  WAITLIST_HOLD // reserved for the waitlist: unassigned, or offered to `waitlistEntryId`
}

/// Admin-owned, reusable venue map.
model SeatMap {
  id          String   @id @default(uuid()) @db.Uuid
  venueName   String   @map("venue_name")
  venueNameMy String?  @map("venue_name_my")
  city        String
  address     String?
  latitude    Float?
  longitude   Float?
  mapUrl      String?  @map("map_url")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  versions SeatMapVersion[]

  @@map("seat_maps")
}

/// A published version is immutable; editing creates a new draft version.
model SeatMapVersion {
  id          String    @id @default(uuid()) @db.Uuid
  seatMapId   String    @map("seat_map_id") @db.Uuid
  version     Int
  layout      Json
  seatCount   Int       @map("seat_count")
  createdById String    @map("created_by_id") @db.Uuid
  publishedAt DateTime? @map("published_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  seatMap   SeatMap @relation(fields: [seatMapId], references: [id], onDelete: Restrict)
  createdBy User    @relation("SeatMapVersionCreator", fields: [createdById], references: [id])
  events    Event[]

  @@unique([seatMapId, version])
  @@map("seat_map_versions")
}

/// Maps a section (or one row of it) to a ticket type for an event. Most specific wins.
model EventSection {
  id           String  @id @default(uuid()) @db.Uuid
  eventId      String  @map("event_id") @db.Uuid
  sectionKey   String  @map("section_key")
  rowLabel     String? @map("row_label") // null = whole section
  ticketTypeId String  @map("ticket_type_id") @db.Uuid

  event      Event      @relation(fields: [eventId], references: [id], onDelete: Cascade)
  ticketType TicketType @relation(fields: [ticketTypeId], references: [id], onDelete: Cascade)

  @@unique([eventId, sectionKey, rowLabel])
  @@map("event_sections")
}

/// One row per seat of a seated event.
model EventSeat {
  id              String     @id @default(uuid()) @db.Uuid
  eventId         String     @map("event_id") @db.Uuid
  seatKey         String     @map("seat_key")
  sectionKey      String     @map("section_key")
  rowLabel        String     @map("row_label")
  seatLabel       String     @map("seat_label")
  label           String
  labelMy         String?    @map("label_my")
  ticketTypeId    String?    @map("ticket_type_id") @db.Uuid
  status          SeatStatus @default(UNSOLD)
  orderId         String?    @map("order_id") @db.Uuid
  ticketId        String?    @unique @map("ticket_id") @db.Uuid
  holdLabel       String?    @map("hold_label")
  heldUntil       DateTime?  @map("held_until")
  waitlistEntryId String?    @map("waitlist_entry_id") @db.Uuid

  event         Event          @relation(fields: [eventId], references: [id], onDelete: Cascade)
  ticketType    TicketType?    @relation(fields: [ticketTypeId], references: [id])
  ticket        Ticket?        @relation(fields: [ticketId], references: [id])
  waitlistEntry WaitlistEntry? @relation(fields: [waitlistEntryId], references: [id], onDelete: SetNull)

  @@unique([eventId, seatKey])
  @@index([eventId, status])
  @@index([ticketTypeId])
  @@index([orderId])
  @@map("event_seats")
}

enum WaitlistStatus {
  WAITING
  OFFERED
  PURCHASED
  EXPIRED
  LEFT
}

/// A buyer in line for a sold-out ticket type. Position is the order of (createdAt, id) among WAITING entries.
/// At most one WAITING/OFFERED entry per user and type (partial unique index in the migration).
model WaitlistEntry {
  id             String         @id @default(uuid()) @db.Uuid
  ticketTypeId   String         @map("ticket_type_id") @db.Uuid
  userId         String         @map("user_id") @db.Uuid
  quantity       Int
  status         WaitlistStatus @default(WAITING)
  /// Tickets (standing) or seats (seated) reserved for this entry while OFFERED.
  offeredQty     Int            @default(0) @map("offered_qty")
  offeredAt      DateTime?      @map("offered_at")
  offerExpiresAt DateTime?      @map("offer_expires_at")
  orderId        String?        @map("order_id") @db.Uuid
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")

  ticketType TicketType  @relation(fields: [ticketTypeId], references: [id], onDelete: Cascade)
  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  order      Order?      @relation(fields: [orderId], references: [id], onDelete: SetNull)
  seats      EventSeat[]

  @@index([ticketTypeId, status, createdAt])
  @@index([userId, status])
  @@index([status, offerExpiresAt])
  @@map("waitlist_entries")
}
