# PostgreSQL (external cluster) — via PgBouncer in Kubernetes
DATABASE_URL=postgresql://event360:change-me@localhost:5432/event360?schema=public
# Direct (non-pooled) URL used by `prisma migrate`
DIRECT_DATABASE_URL=postgresql://event360:change-me@localhost:5432/event360?schema=public
REDIS_URL=redis://localhost:6379
JWT_ACCESS_SECRET=dev-access-secret-change-me
JWT_REFRESH_SECRET=dev-refresh-secret-change-me
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
OTP_TTL_SECONDS=300
# In dev, OTP codes are logged instead of sent by SMS
OTP_DEV_ECHO=true
# SeaweedFS S3 gateway
S3_ENDPOINT=http://seaweedfs-s3:8333
S3_REGION=us-east-1
S3_BUCKET_MEDIA=media
PORT=3000
TRUST_PROXY=0
