{
  "name": "event360",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "manifests": "node infra/manifests/generate.mjs",
    "manifests:check": "node infra/manifests/generate.mjs --check",
    "test:manifests": "node --test infra/manifests/generate.spec.mjs"
  },
  "devDependencies": {
    "js-yaml": "^4.3.2",
    "turbo": "^2.3.3"
  },
  "pnpm": {
    "overrides": {
      "multer": "^2.5.0",
      "body-parser": "^1.20.9",
      "js-yaml": "^4.3.2",
      "lodash": "^4.18.0"
    }
  }
}
