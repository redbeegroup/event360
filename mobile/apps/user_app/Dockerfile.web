# Serves a prebuilt Flutter web build (CI runs `flutter build web` first) with unprivileged nginx on 8080 (uid 101).
# Build context: mobile/apps/user_app
FROM nginxinc/nginx-unprivileged:1.27-alpine
COPY web-nginx.conf /etc/nginx/conf.d/default.conf
COPY build/web /usr/share/nginx/html
EXPOSE 8080
